# Copy to .env and fill in real values. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://longevity-alpha.vercel.app

# --- Supabase (Phase 4 — not wired up yet) ---
# Must be a NEW PERSONAL Supabase project. Never AmuseUp's project or keys.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
# Service-role key: privileged, bypasses RLS. Only for server-side writes
# that must ignore RLS (e.g. usage_events, ingest scripts) — never sent to
# the browser. Not read by any code yet; add it once Fase 4 lands.
SUPABASE_SERVICE_ROLE_KEY=

LOG_LEVEL=INFO
